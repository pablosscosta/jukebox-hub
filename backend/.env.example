# Spotify app (https://developer.spotify.com/dashboard)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:3000/auth/spotify/callback

# Where the API redirects the host after login (also used for CORS)
FRONTEND_ORIGIN=http://127.0.0.1:5173


# Optional, dev only: base of invite links so phones on the same Wi-Fi can open them
# (e.g. http://<notebook-ip>:5173). Defaults to FRONTEND_ORIGIN.
INVITE_ORIGIN=
