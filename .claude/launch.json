{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend",
      "runtimeExecutable": "bash",
      "runtimeArgs": [
        "-c",
        "cd backend && PATH=$HOME/.local/share/mise/installs/ruby/4.0.10/bin:$PATH exec bin/dev -b 0.0.0.0"
      ],
      "port": 3000,
      "autoPort": false
    },
    {
      "name": "frontend",
      "runtimeExecutable": "bash",
      "runtimeArgs": [
        "-c",
        "cd frontend && exec npm run dev"
      ],
      "port": 5173,
      "autoPort": false
    }
  ]
}
